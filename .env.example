# Copy to .env and fill in. NEVER commit .env. Every key is optional:
# with no keys the system still runs using built-in rule-based explanations.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Voice provider key (server-side speech). Browser voice works without it.
VOICE_API_KEY=
# Optional Mem0 platform memory. Local SQLite memory is used if empty.
MEM0_API_KEY=
# Gateway
CP_HOST=127.0.0.1
CP_PORT=8000
CP_CREW=A1,A2,A3,A4
# --- NASA data integration (backend only; never put keys in frontend code) ---
# Free key: https://api.nasa.gov/   (DEMO_KEY works but is limited to ~30 requests/hour)
NASA_API_KEY=
# Optional: documented base URL of the Environmental Data App API, once you have confirmed it
# in the EDA "API" section (https://visualization.osdr.nasa.gov/eda/). Never guessed by the code.
EDA_API_BASE=
NASA_MAX_DOWNLOAD_MB=25
